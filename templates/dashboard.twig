{% extends 'base.twig' %}

{% block title %}Dashboard — Grounds for Concern{% endblock %}

{% block content %}
{% for f in flash %}
<div class="notice notice-{{ f.type }}" role="status">{{ f.text }}{% if f.link is defined %} <a class="notice-link" href="{{ f.link.href }}">{{ f.link.label }}</a>{% endif %}</div>
{% endfor %}

<details class="add-cup"{% if form_errors %} open{% endif %}>
    <summary class="btn btn-primary">
        <span class="btn-hero-plus" aria-hidden="true">+</span> Add a cup
    </summary>
    <div class="add-cup-body">
        <form method="post" action="/transactions/add" class="log-form">
            <label class="field field-grow">
                <span class="field-label">Merchant</span>
                <input type="text" name="merchant" list="log-merchants" maxlength="120"
                       value="{{ form_submitted.merchant ?? '' }}" placeholder="Second Cup"
                       class="{{ form_errors.merchant is defined ? 'input-error' }}" required>
                {% if form_errors.merchant is defined %}<span class="field-error">{{ form_errors.merchant }}</span>{% endif %}
            </label>
            <label class="field">
                <span class="field-label">Amount</span>
                <input type="text" inputmode="decimal" name="amount"
                       value="{{ form_submitted.amount ?? '' }}" placeholder="4.75"
                       class="{{ form_errors.amount is defined ? 'input-error' }}" required>
                {% if form_errors.amount is defined %}<span class="field-error">{{ form_errors.amount }}</span>{% endif %}
            </label>
            <label class="check-row">
                <input type="checkbox" name="home_made" value="1"
                       {{ form_submitted.home_made is defined ? 'checked' }}>
                <span>Home made</span>
            </label>
            <label class="field">
                <span class="field-label">Date</span>
                <input type="date" name="date" value="{{ form_submitted.date ?? "now"|date("Y-m-d") }}" max="{{ "now"|date("Y-m-d") }}"
                       class="{{ form_errors.date is defined ? 'input-error' }}">
                {% if form_errors.date is defined %}<span class="field-error">{{ form_errors.date }}</span>{% endif %}
            </label>
            <button type="submit" class="btn btn-primary log-submit">Add</button>
        </form>
        <datalist id="log-merchants">
            {% for m in merchants %}<option value="{{ m }}"></option>{% endfor %}
        </datalist>
    </div>
</details>

<section class="card-row">
    <div class="card">
        <h2 class="card-label">Bought (7 days)</h2>
        <p class="card-value">${{ bought7.total_cents|money }}</p>
        <p class="card-sub">{{ bought7.count }} cup{{ bought7.count == 1 ? '' : 's' }}</p>
        {% if budget7 %}
        <div class="meter" role="img"
             aria-label="Bought coffee at {{ (bought7.total_cents / budget7.threshold_cents * 100)|round }} percent of the ${{ budget7.threshold_cents|money }} 7-day budget">
            <div class="meter-fill {% if budget7.over %}is-over{% endif %}"
                 style="width: {{ min(bought7.total_cents / budget7.threshold_cents * 100, 100) }}%"></div>
        </div>
        {% endif %}
    </div>

    <div class="card">
        <h2 class="card-label">Bought (30 days)</h2>
        <p class="card-value">${{ bought30.total_cents|money }}</p>
        <p class="card-sub">{{ bought30.count }} cup{{ bought30.count == 1 ? '' : 's' }}</p>
        {% if budget30 %}
        <div class="meter" role="img"
             aria-label="Bought coffee at {{ (bought30.total_cents / budget30.threshold_cents * 100)|round }} percent of the ${{ budget30.threshold_cents|money }} 30-day budget">
            <div class="meter-fill {% if budget30.over %}is-over{% endif %}"
                 style="width: {{ min(bought30.total_cents / budget30.threshold_cents * 100, 100) }}%"></div>
        </div>
        {% endif %}
    </div>

    <div class="card">
        <h2 class="card-label">Home-made streak</h2>
        <p class="card-value">{{ streak }} day{{ streak == 1 ? '' : 's' }}</p>
        <p class="card-sub">{{ home7.count }} cup{{ home7.count == 1 ? '' : 's' }} brewed · ${{ home7.total_cents|money }}</p>
    </div>
</section>

<section class="panel">
    <div class="panel-head">
        <h2>Recent Cups</h2>
        <a class="btn" href="/rules">New rule</a>
    </div>

    {% if recent %}
    <table class="table">
        <thead>
        <tr>
            <th>Date</th>
            <th>Merchant</th>
            <th>Category</th>
            <th class="num">Amount</th>
        </tr>
        </thead>
        <tbody>
        {% for t in recent %}
            <tr>
                <td class="nowrap">{{ t.occurred_on|date('D M j') }}</td>
                <td>{{ t.merchant }}</td>
                <td><span class="chip chip-{{ t.category }}">{{ t.category|replace({'_': ' '}) }}</span></td>
                <td class="num">${{ t.amount_cents|money }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div class="empty">
        <p>No purchases yet.</p>
    </div>
    {% endif %}
    </div>
</section>
{% endblock %}
