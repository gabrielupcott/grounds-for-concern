{% if result.episode_count == 0 %}
    <p class="backtest-verdict ok">No — it would have stayed quiet for 90 days.</p>
{% else %}
    <p class="backtest-verdict">
        It would have fired <strong>{{ result.episode_count }} time{{ result.episode_count == 1 ? '' : 's' }}</strong>
        in the last 90 days:
    </p>
    <ul class="episode-list">
        {% for e in result.episodes %}
            <li>
                <span class="episode-when">{{ e.start|date('M j') }}–{{ e.end|date('M j') }}</span>
                <span class="num">peak ${{ e.peak_total_cents|money }}</span>
            </li>
        {% endfor %}
    </ul>
{% endif %}
